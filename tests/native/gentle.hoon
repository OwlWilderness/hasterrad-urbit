=/  w  (fresh:c ~dirted-pallup)
?>  =(2 (lent targets.w))
=/  early  (step-wave:hasterrad-enemies [0 1 80 0 ~ ~] 300 512 384 1)
?>  &(=(~ enemies.early) =(~ shots.early))
=/  two  (step-wave:hasterrad-enemies [0 1 80 0 ~ ~] 300 512 384 2)
?>  &(=(~ enemies.two) =(~ shots.two))
=/  waiting  (step-wave:hasterrad-enemies [0 1 150 0 ~ ~] 149 512 384 3)
?>  =(~ enemies.waiting)
=/  three  (step-wave:hasterrad-enemies waiting 150 512 384 3)
=/  enemy  (snag 0 enemies.three)
?>  &(=(1 (lent enemies.three)) =(%large kind.enemy) =(2 (magnitude:hasterrad-enemies vx.enemy)))
=/  capped  (step-wave:hasterrad-enemies three(spawn-at 151) 151 512 384 3)
?>  =(1 (lent enemies.capped))
=/  four  (step-wave:hasterrad-enemies [0 1 1 1 ~ ~] 1 512 384 4)
=/  e4  (snag 0 enemies.four)
?>  =(%large kind.e4)
=/  five  (step-wave:hasterrad-enemies [0 1 1 1 ~ ~] 1 512 384 5)
=/  e5  (snag 0 enemies.five)
?>  =(%small kind.e5)
