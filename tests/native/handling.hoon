::  Bounded player tuning; one native step keeps its existing duration.
=/  w  (fixture:c ~dirted-pallup)
=/  target  (spawn:c ~dirted-pallup 1)
=.  w  w(shield 999, targets ~[target(x 100.000, y 100.000, vx --0, vy --0)])
=/  forward  (step:c w [%| %| %& %|])
?>  =((add x.w 16.384) x.forward)
?>  &(=(y.w y.forward) =(--16.384 vx.forward) =(--0 vy.forward) =(1 tick.forward))
=/  right  (step:c w [%| %& %| %|])
=/  left  (step:c w [%& %| %| %|])
?>  &(=(10 angle.right) =(350 angle.left))
=/  cancel  (step:c w [%& %& %& %|])
?>  &(=(0 angle.cancel) =(x.forward x.cancel) =(y.forward y.cancel))
=/  stopped  (step:c forward [%| %| %| %|])
?>  &(=(x.forward x.stopped) =(y.forward y.stopped) =(--0 vx.stopped) =(--0 vy.stopped))
=/  wrapped  (step:c w(x 1.040.000) [%| %| %& %|])
?>  =(7.808 x.wrapped)
=/  vertical  (step:c w(y 780.000, angle 90) [%| %| %& %|])
?>  &(=(x.w x.vertical) =(9.952 y.vertical))
=/  backward  (step:c w(x 8.000, angle 180) [%| %| %& %|])
?>  =(1.040.192 x.backward)
=/  turn-wrap  (step:c w(angle 355) [%| %& %| %|])
?>  =(5 angle.turn-wrap)
=/  left-wrap  (step:c w(angle 5) [%& %| %| %|])
?>  =(355 angle.left-wrap)
=/  diagonal  (step:c w [%| %& %& %|])
=/  expected  (vector:c 10 16.384)
?>  &(=(10 angle.diagonal) =(vx.expected vx.diagonal) =(vy.expected vy.diagonal))
=/  shot  (step:c w [%| %| %& %&])
=/  bullet  (snag 0 shots.shot)
?>  &(=(1 (lent shots.shot)) =(--24.576 vx.bullet) =(29 ttl.bullet) (gth (abs:si vx.bullet) (abs:si vx.shot)))
=/  full  w(shots ~[[11 10 10 0 30 --0 --0] [12 10 10 0 30 --0 --0] [13 10 10 0 30 --0 --0] [14 10 10 0 30 --0 --0]])
=/  capped  (step:c full [%| %| %| %&])
?>  &(=(4 (lent shots.capped)) =(next.full next.capped))
?>  &(=(level.w level.forward) =(phase.w phase.forward) =(score.w score.forward) =(lives.w lives.forward))
=/  circle
  =/  n=@ud  36
  =/  v=world:c  w
  |-  ^-  world:c
  ?:  =(0 n)  v
  $(n (dec n), v (step:c v [%| %& %| %|]))
?>  &(=(0 angle.circle) =(36 tick.circle) =(x.w x.circle) =(y.w y.circle))
