=/  w  (fresh:c ~dirted-pallup)
?>  &(=(1 level.w) =(%active phase.w) =(2 (lent targets.w)))
=/  t  (spawn:c ~dirted-pallup 80)
=/  parts  (split:c t 81)
?>  =(2 (lent parts))
=/  half  (snag 0 parts)
?>  =(2 (lent syllables.half))
=/  quarters  (split:c half 83)
=/  quarter  (snag 0 quarters)
?>  =(1 (lent syllables.quarter))
=.  w  w(targets ~, score 270, lives 3, shots ~[[80 5 5 0 10 --0 --0]])
=/  pause  (step:c w [%& %& %& %&])
?>  &(=(%complete phase.pause) =(15 pause.pause) =(1 level.pause) =(~ shots.pause) =(~ enemies.foes.pause) =(~ shots.foes.pause))
=/  n
  =/  left=@ud  14
  =/  v=world:c  pause
  |-  ^-  world:c
  ?:  =(0 left)  v
  $(left (dec left), v (step:c v [%& %& %& %&]))
?>  &(=(%complete phase.n) =(1 pause.n) =(270 score.n) =(3 lives.n) =(x.pause x.n) =(y.pause y.n))
=.  n  (step:c n [%& %& %& %&])
?>  &(=(2 level.n) =(%active phase.n) =(3 (lent targets.n)) =(~ shots.n) =(270 score.n) =(3 lives.n))
?>  !(lien targets.n |=(t=target:c (near:c x.n y.n x.t y.t 300)))
=/  high  (seed-wave:c n(level 99))
?>  &(=(6 (lent targets.high)) =(4 (difficulty:c 99)) =(4 (difficulty:c 999.999)))
=/  done  (complete-wave:c high(targets ~))
=/  higher  (step:c done(pause 1) [%| %| %| %|])
?>  &(=(99 level.higher) =(6 (lent targets.higher)))
=/  foe  (step-level:hasterrad-enemies [0 1 1 0 ~ ~] 1 512 384 999)
=/  enemy  (snag 0 enemies.foe)
?>  &(=(41 spawn-at.foe) =(1 (lent enemies.foe)) =(7 (magnitude:hasterrad-enemies vx.enemy)))
=/  bits  (split:c t 100)
=/  frag  (snag 0 bits)
=/  retained  (step:c n(targets ~[frag(x 100.000, y 100.000)]) [%| %| %| %|])
?>  =(%active phase.retained)
